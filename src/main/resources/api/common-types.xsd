<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
            xmlns:common="http://standardbank.ao/common/types/1.0"
            targetNamespace="http://standardbank.ao/common/types/1.0"
            elementFormDefault="qualified">

    <!-- ===================== ENUMS COMUNS ===================== -->
    <xsd:simpleType name="RiskFlag">
        <xsd:restriction base="xsd:string">
            <xsd:enumeration value="BAIXO"/>
            <xsd:enumeration value="MEDIO"/>
            <xsd:enumeration value="ALTO"/>
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="CardAction">
        <xsd:restriction base="xsd:string">
            <xsd:enumeration value="BLOQUEAR"/>
            <xsd:enumeration value="DESBLOQUEAR"/>
        </xsd:restriction>
    </xsd:simpleType>

    <!-- ===================== TIPOS COMPLEXOS COMUNS ===================== -->
    <xsd:complexType name="AccountSummary">
        <xsd:sequence>
            <xsd:element name="accountId" type="xsd:long"/>
            <xsd:element name="iban" type="xsd:string"/>
            <xsd:element name="accountType" type="xsd:string"/>
            <xsd:element name="currency" type="xsd:string"/>
            <xsd:element name="balance" type="xsd:decimal"/>
            <xsd:element name="status" type="xsd:string" minOccurs="0"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="TransactionSummary">
        <xsd:sequence>
            <xsd:element name="transactionId" type="xsd:long"/>
            <xsd:element name="description" type="xsd:string"/>
            <xsd:element name="category" type="xsd:string" minOccurs="0"/>
            <xsd:element name="amount" type="xsd:decimal"/>
            <xsd:element name="transactionDate" type="xsd:dateTime"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="StatementTransaction">
        <xsd:sequence>
            <xsd:element name="transactionId" type="xsd:long"/>
            <xsd:element name="transactionDate" type="xsd:dateTime"/>
            <xsd:element name="description" type="xsd:string"/>
            <xsd:element name="category" type="xsd:string" minOccurs="0"/>
            <xsd:element name="amount" type="xsd:decimal"/>
            <xsd:element name="type" type="xsd:string"/> <!-- DEBITO ou CREDITO -->
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="InsightCard">
        <xsd:sequence>
            <xsd:element name="category" type="xsd:string"/>
            <xsd:element name="message" type="xsd:string"/>
            <xsd:element name="changePercentage" type="xsd:decimal" minOccurs="0"/>
        </xsd:sequence>
    </xsd:complexType>

    <!-- ===================== FAULT GENÉRICO COMUM ===================== -->
    <xsd:element name="ExperienceFault">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element name="errorCode" type="xsd:string"/>
                <xsd:element name="errorMessage" type="xsd:string"/>
                <xsd:element name="correlationId" type="xsd:string"/>
                <xsd:element name="timestamp" type="xsd:string"/>
            </xsd:sequence>
        </xsd:complexType>
    </xsd:element>

</xsd:schema>
